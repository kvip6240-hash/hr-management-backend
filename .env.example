PORT=5000

NODE_ENV=development

# MongoDB Atlas connection string (Atlas → Database → Connect → Drivers).
# URL-encode special characters in the password (@ → %40, : → %3A, / → %2F, # → %23).
# Atlas → Network Access must allow your server's IP (Render: 0.0.0.0/0 or its static outbound IPs).
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>.mongodb.net/hr_management?retryWrites=true&w=majority
# Local fallback: mongodb://127.0.0.1:27017/hr_management
# Optional: how long to wait for Atlas on startup (ms)
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required in production (server refuses to start with defaults). Must be different from each other.
JWT_SECRET=replace_with_random_secret_at_least_32_characters
JWT_EXPIRES_IN=1d

JWT_REFRESH_SECRET=replace_with_a_different_random_secret_at_least_32_characters
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins (localhost on any port is always allowed)
CLIENT_URL=http://localhost:3000

# Max login/refresh/reset attempts per IP+email per 15 minutes (default 20)
# AUTH_RATE_LIMIT_MAX=20

# Used only by the seed scripts. Choose strong passwords.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_me_strong_password
SEED_SUPER_ADMIN_EMAIL=superadmin@example.com
SEED_SUPER_ADMIN_PASSWORD=change_me_strong_password
